{
  "name": "cvd-tools",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/detective",
    "build": "npm run build -w apps/detective",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "check:i18n": "npm run check:i18n -w apps/detective"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
